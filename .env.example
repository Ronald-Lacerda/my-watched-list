# Compose lê este arquivo quando usado com --env-file .env.
POSTGRES_USER=watched
POSTGRES_DB=watched
# Gere com: openssl rand -hex 32 (use somente caracteres seguros para uma URL).
POSTGRES_PASSWORD=

# Apenas produção: domínio com DNS apontando para a VPS, sem protocolo/caminho.
APP_DOMAIN=
# Origens locais autorizadas para login/notas. Em produção o override usa HTTPS + APP_DOMAIN.
APP_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Worker: TMDB é opcional para coletar; sem token, o enriquecimento fica pendente.
# Nunca coloque estes valores no frontend nem em variáveis VITE_*.
TMDB_READ_ACCESS_TOKEN=
SESSION_ENCRYPTION_KEY=
# Gere a chave com openssl rand -base64 32. Não troque após salvar sessões sem
# recifrá-las; esta fase aceita somente a versão 1.
SYNC_CRON=0 4 * * *
SYNC_TIMEZONE=America/Sao_Paulo

# Fora do Docker, exporte DATABASE_URL no shell antes de iniciar API/worker.
# DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/watched?sslmode=disable
# HTTP_ADDR=127.0.0.1:8080
