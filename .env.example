# Compose lê este arquivo quando usado com --env-file .env.
POSTGRES_USER=watched
POSTGRES_DB=watched
# Gere com: openssl rand -hex 32 (use somente caracteres seguros para uma URL).
POSTGRES_PASSWORD=

# Apenas produção: domínio com DNS apontando para a VPS, sem protocolo/caminho.
APP_DOMAIN=

# Reservadas para a Fase 1, ainda não consumidas nesta fase.
# Nunca coloque estes valores no frontend nem em variáveis VITE_*.
TMDB_READ_ACCESS_TOKEN=
SESSION_ENCRYPTION_KEY=

# Fora do Docker, exporte DATABASE_URL no shell antes de iniciar API/worker.
# DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/watched?sslmode=disable
# HTTP_ADDR=127.0.0.1:8080
