FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY internal ./internal
COPY worker ./worker
RUN CGO_ENABLED=0 go build -trimpath -o /out/api ./api/cmd/api \
    && CGO_ENABLED=0 go build -trimpath -o /out/migrate ./api/cmd/migrate \
    && CGO_ENABLED=0 go build -trimpath -o /out/worker ./worker/cmd/worker

FROM alpine:3.23 AS runtime
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S app && adduser -S -G app app
WORKDIR /app
COPY --from=build /out/ /app/
USER app
CMD ["/app/api"]
